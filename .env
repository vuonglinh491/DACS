# ============================================================
#  LKSecure — Cấu hình môi trường (.env)
#  QUAN TRỌNG: Không commit file này lên git!
# ============================================================

# ── Môi trường ───────────────────────────────────────────────
APP_ENV=development
APP_NAME=LKSecure
APP_URL=http://localhost/DACS

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=dacs1
DB_CHARSET=utf8

# ── Admin mặc định (dùng để tạo DB seed) ────────────────────
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin LKSecure

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/DACS/callback/google_callback.php

# ── Facebook OAuth ───────────────────────────────────────────
FB_APP_ID=YOUR_FACEBOOK_APP_ID
FB_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
FB_REDIRECT_URI=http://localhost:8000/DACS/callback/facebook_callback.php

# ── Session ──────────────────────────────────────────────────
SESSION_LIFETIME=3600
SESSION_NAME=lksecure_session

# ── Upload ───────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=assets/imgs/